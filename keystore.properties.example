# Template for release signing values. Copy to keystore.properties (same folder) and
# fill in your own values. keystore.properties and all *.jks files are git-ignored.
# NEVER commit them.
#
# NOTE: app/build.gradle.kts does not read this file yet. assembleRelease currently
# produces an UNSIGNED APK (app-release-unsigned.apk). This file documents the values
# you need to sign it yourself (for example with apksigner), and is the intended
# input for a release signing config if one is added later.

# Path to the release keystore. Absolute, or starting with ~ for your home folder.
# Keep the keystore OUTSIDE the project folder. Use forward slashes, even on Windows.
storeFile=~/keystores/your-release-key.jks

# Password for the keystore file.
storePassword=CHANGE_ME

# Alias of the signing key inside the keystore.
keyAlias=your-key-alias

# Password for that key. For a PKCS12 keystore this is the same as storePassword.
keyPassword=CHANGE_ME
