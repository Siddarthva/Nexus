<?xml version="1.0" encoding="utf-8"?>
<!--
    NEXUS launcher icon, foreground layer (108x108 canvas, artwork inside the 66dp safe zone).
    A glowing circular D-pad with the OK button in the centre, plus two broadcast arcs at the
    upper right: "a remote that talks to your TV over Wi-Fi".
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft violet glow behind the D-pad -->
    <path android:pathData="M21,54a33,33 0,1 0,66 0a33,33 0,1 0,-66 0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="33">
                <item android:offset="0" android:color="#998B6CFF" />
                <item android:offset="0.6" android:color="#528B6CFF" />
                <item android:offset="1" android:color="#008B6CFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Broadcast arcs (wireless) -->
    <path
        android:pathData="M66.47,27.26 A29.5,29.5 0,0 1,80.74 41.53"
        android:strokeColor="#F2C9BBFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M70.5,25.42 A33,33 0,0 1,82.58 37.5"
        android:strokeColor="#8CC9BBFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />

    <!-- D-pad ring with the four arrow cut-outs -->
    <path
        android:fillType="evenOdd"
        android:pathData="M28.5,54a25.5,25.5 0,1 0,51 0a25.5,25.5 0,1 0,-51 0z M38,54a16,16 0,1 0,32 0a16,16 0,1 0,-32 0z M54,30.6L57.6,35.6L50.4,35.6z M54,77.4L50.4,72.4L57.6,72.4z M30.6,54L35.6,50.4L35.6,57.6z M77.4,54L72.4,57.6L72.4,50.4z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="32"
                android:startY="30"
                android:endX="78"
                android:endY="80">
                <item android:offset="0" android:color="#FFECE5FF" />
                <item android:offset="0.45" android:color="#FFA68EFF" />
                <item android:offset="1" android:color="#FF5E3BEF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner bevel for depth -->
    <path
        android:pathData="M37.6,54a16.4,16.4 0,1 0,32.8 0a16.4,16.4 0,1 0,-32.8 0z"
        android:strokeColor="#8C1A1240"
        android:strokeWidth="1" />

    <!-- Gloss highlight on the ring -->
    <path
        android:pathData="M32.43,43.94 A23.8,23.8 0,0 1,43.94 32.43"
        android:strokeColor="#99FFFFFF"
        android:strokeWidth="1.3"
        android:strokeLineCap="round" />

    <!-- OK button -->
    <path android:pathData="M45,54a9,9 0,1 0,18 0a9,9 0,1 0,-18 0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="51.5"
                android:centerY="51"
                android:gradientRadius="11">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.55" android:color="#FFE4DCFF" />
                <item android:offset="1" android:color="#FF9C85FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
